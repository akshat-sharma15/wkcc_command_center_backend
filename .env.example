# Webkorps Command Center Backend - local environment configuration
#
#   cp .env.example .env
#
# Loaded automatically (via dotenv-rails) by any rails/sidekiq/rspec
# command - no `source` step needed. `source scripts/dev_env.sh` is only
# needed for bundle install's pg_config PATH, or to use psql/redis-cli
# directly in your shell (see DEVELOPMENT_SETUP.md).
#
# .env is gitignored and must never be committed.

# RAILS_ENV is intentionally not set here - Rails defaults to "development"
# on its own, and hardcoding it would leak into `bundle exec rspec` runs
# (rails_helper.rb's `ENV['RAILS_ENV'] ||= 'test'` can't override an
# already-exported value). Set it explicitly only for one-off commands,
# e.g. `RAILS_ENV=production bundle exec rails ...`.
RAILS_MAX_THREADS=5

# --- PostgreSQL (shared local Postgres 16 instance also used by the
#     Wk_command_center/Superset project, on a non-default port to avoid
#     colliding with other Postgres instances on this machine) ---
PGHOST=localhost
PGPORT=55432
PGUSER=wkcc_backend_app
PGPASSWORD=changeme-local-postgres-password

PRIMARY_DB_NAME=wkcc_backend_development
OPERATIONS_DB_NAME=wkcc_ops_development
COMMAND_CENTER_DB_NAME=wkcc_cc_development
PRIMARY_TEST_DB_NAME=wkcc_backend_test
OPERATIONS_TEST_DB_NAME=wkcc_ops_test
COMMAND_CENTER_TEST_DB_NAME=wkcc_cc_test

# --- Redis (reuses the Wk_command_center project's isolated local Redis
#     instance on port 6380; that project reserves logical DB indices
#     1/2/3, so this app reserves 4/5/6 to avoid any collision) ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_SIDEKIQ_DB=4
REDIS_CACHE_DB=5
REDIS_EVENTS_DB=6

# --- Sidekiq Web UI (mounted at /sidekiq, Basic Auth gated) ---
SIDEKIQ_WEB_USERNAME=admin
SIDEKIQ_WEB_PASSWORD=admin

# --- App server ---
PORT=3001

# --- Superset metadata DB (read-only, for alert recipient lookup — see
#     SupersetDirectory/SupersetRecord). Not part of this app's own
#     migration-managed databases above; never migrated by this app.
#     Leave unset (as below) to keep Superset integration disabled —
#     SupersetDirectory then safely returns empty results instead of
#     attempting a connection. Grant SUPERSET_PGUSER SELECT only on
#     Superset's ab_user/ab_role/ab_user_role tables, nothing else.
# SUPERSET_PGHOST=
# SUPERSET_PGPORT=5432
# SUPERSET_PGDATABASE=
# SUPERSET_PGUSER=
# SUPERSET_PGPASSWORD=

# --- Slack OAuth + alert delivery (see SlackOauthClient,
#     SlackIntegrationsController, NotificationDeliveryJob). Create a
#     Slack App at https://api.slack.com/apps, add the `chat:write` bot
#     scope, and add SLACK_REDIRECT_URI below under OAuth & Permissions ->
#     Redirect URLs. SLACK_CLIENT_SECRET is a real secret — never commit it.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/v1/integrations/slack/callback

# Where alert notifications get posted (chat.postMessage). A channel id
# (e.g. C0123456789 — from the channel's "Copy link" in Slack) or name
# (e.g. #alerts). The bot must be invited to it (/invite @YourBotName in
# that channel) — chat:write alone doesn't let the bot post to channels
# it hasn't been added to. Left blank, Slack delivery fails cleanly
# (Notification.status = "failed", not a silent no-op).
SLACK_NOTIFICATION_CHANNEL=

# Where the Slack OAuth callback redirects the browser back to after
# connecting/failing to connect (see redirect_to_frontend). Same origin
# CORS is already configured for (config/initializers/cors.rb).
FRONTEND_BASE_URL=http://localhost:9000

# --- Command Centre AI chatbot (Phase 5) ---
# Google Gemini API key (https://aistudio.google.com/apikey). Never
# commit a real value here — see GeminiClient, which reads this at
# request time and never logs it. Left blank, the AI chat endpoint fails
# cleanly with a clear error rather than silently misbehaving.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Dedicated read-only Postgres role (see config/database.yml's
# `ai_readonly` connection) granted SELECT only on the AI's approved
# operations-DB views/tables — never on warehouses/payment_dues/
# alert_rules/event_definitions/notifications, and set
# default_transaction_read_only=on server-side as defense in depth.
# Provisioning SQL: see docs/ai_readonly_role.sql.
AI_READONLY_PGUSER=wkcc_ai_readonly
AI_READONLY_PGPASSWORD=
