# Test-environment overrides, loaded before .env (dotenv-rails: files are
# first-loaded-wins, and .env.test is loaded before the plain .env — see
# vendor/bundle/.../dotenv-3.2.0/lib/dotenv/rails.rb).
#
# Superset is deliberately left unconfigured here even when the shared
# dev .env has real credentials (see ARCHITECTURE.md/SUPERSET_PG* in
# .env.example) — the test suite must stay hermetic and never depend on
# or hit a real external Superset database. SupersetDirectory-dependent
# behavior is covered by RSpec stubs (`allow(SupersetDirectory).to
# receive(...)`), not by a real connection.
SUPERSET_PGHOST=
SUPERSET_PGDATABASE=
SUPERSET_PGUSER=
SUPERSET_PGPASSWORD=

# Same reasoning for the Slack notification channel - specs that need a
# "configured" channel set it explicitly per-example (see
# notification_delivery_job_spec.rb), and WebMock already blocks any real
# request to slack.com regardless.
SLACK_NOTIFICATION_CHANNEL=
